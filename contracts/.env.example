# THYRK deploy env — NEVER put a real private key here or in chat.
# The deployer key is only needed when deploying via the Hardhat CLI.
# Deploy via the browser page (site/deploy.html) needs no key at all.
DEPLOYER_PRIVATE_KEY=
BSC_RPC=https://bsc-dataseed.binance.org/
BSCSCAN_API_KEY=
